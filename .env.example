# ─────────────────────────────────────────────────────────────────────────────
# Jainam — API / server-side environment. Copy to `.env` at the repo ROOT.
# The Expo app has its OWN file: apps/mobile/.env (only EXPO_PUBLIC_* there).
# `pnpm dev` (turbo) passes these to the tasks; see turbo.json → globalEnv.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ───────────────────────────────────────────────────────────────
# Local stack (`pnpm db:start` prints all of these):  SUPABASE_URL=http://127.0.0.1:54321
# Hosted project — Supabase dashboard → Project Settings:
#   SUPABASE_URL              = API → Project URL
#   SUPABASE_ANON_KEY         = API → Project API keys → anon / public
#   SUPABASE_SERVICE_ROLE_KEY = API → Project API keys → service_role / secret  (SERVER ONLY)
#   SUPABASE_JWT_SECRET       = API → JWT Settings → JWT Secret  (HS256 shared secret;
#                               apps/api verifies access tokens with it — MUST be the real value)
#   SUPABASE_DB_URL           = Database → Connection string → URI  (has the DB password;
#                               only used by `pnpm db:migrate`, not by the running API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# ── API (apps/api, Fastify) ────────────────────────────────────────────────
# development | test | production  (default: development)
# In development/test the API exposes /api/dev/* and the app auto-confirms
# new signups so you don't need the email link. Set to `production` for a
# real deployment.
APP_ENV=development
PORT=4000
API_HOST=0.0.0.0

# ── Ask Jainam (optional) ─────────────────────────────────────────────────
# PRIMARY model: anthropic | openai | gemini  (default: anthropic).
# On any error/timeout it auto-falls-through to the other providers that have
# a key set (anthropic → openai → gemini), then to the offline keyword engine.
# Set several keys for resilience, or just one to pin a single provider.
LLM_PROVIDER=anthropic

# Anthropic — model defaults to claude-opus-5.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5
# Only if the key is workspace-linked (Console: "This key is linked to a workspace"):
# ANTHROPIC_WORKSPACE_ID=

# OpenAI — model defaults to gpt-4o-mini.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# Optional: OpenAI-compatible gateway (Azure OpenAI, OpenRouter, …):
# OPENAI_BASE_URL=

# Google Gemini (API key from aistudio.google.com/apikey — no GCP project id needed).
# Model defaults to gemini-3.6-flash.
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-3.6-flash
