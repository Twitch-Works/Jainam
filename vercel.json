{
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter=@jainam/api... run build && mkdir -p public",
  "outputDirectory": "public",
  "framework": null,
  "regions": ["bom1"],
  "functions": {
    "api/serverless.ts": { "maxDuration": 60 }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/serverless" }]
}
