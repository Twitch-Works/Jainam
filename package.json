{
  "name": "jainam",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:mobile": "turbo run dev --filter=@jainam/mobile",
    "dev:api": "turbo run dev --filter=@jainam/api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:seed": "pnpm --filter @jainam/shared build && pnpm --filter @jainam/api build && pnpm --filter @jainam/api db:seed",
    "db:bhajans": "pnpm --filter @jainam/shared build && pnpm --filter @jainam/api build && pnpm --filter @jainam/api db:bhajans",
    "db:types": "supabase gen types typescript --local > packages/shared/src/database.types.ts",
    "db:migrate": "bash scripts/db-migrate.sh"
  },
  "devDependencies": {
    "supabase": "^2.2.1",
    "turbo": "^2.3.4",
    "typescript": "~6.0.3"
  }
}
