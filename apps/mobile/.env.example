# apps/mobile — Expo reads .env from THIS directory (not the repo root).
# Copy to apps/mobile/.env. Only EXPO_PUBLIC_* is exposed to the app bundle,
# so never put a secret here (no service_role key, ever).

# development | test | production  (default: development). In dev/test the app
# auto-confirms new signups via the API instead of waiting for the email link.
# Keep this in sync with APP_ENV in the repo-root .env.
EXPO_PUBLIC_APP_ENV=development

# Where the Fastify API runs.
#   iOS simulator / web:      http://localhost:4000
#   Android emulator:         http://10.0.2.2:4000
#   Physical device (Expo Go): http://<your-computer-LAN-IP>:4000  (API_HOST=0.0.0.0)
EXPO_PUBLIC_API_URL=http://localhost:4000

# Same values as SUPABASE_URL / SUPABASE_ANON_KEY in the repo-root .env.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
